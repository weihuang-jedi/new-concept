LN      =       ln -sf
MAKE    =       make -i -r
RM      =       /bin/rm -f
MV      =       /bin/mv -f
CP      =       /bin/cp -f
AR      =       ar ru
M4      =       m4 -B12000
RANLIB	=       echo

.SUFFIXES: .F90 .f90 .o .f .c .cc

####################################################
NETCDF_C_PATH = /contrib/spack-stack-rocky8/spack-stack-1.6.0/envs/ue-intel/install/intel/2021.10.0/netcdf-c-4.9.2-ow36r2v
NETCDF_F_PATH = /contrib/spack-stack-rocky8/spack-stack-1.6.0/envs/ue-intel/install/intel/2021.10.0/netcdf-fortran-4.6.1-bke33ni
HDF5PATH      = /contrib/spack-stack-rocky8/spack-stack-1.6.0/envs/ue-intel/install/intel/2021.10.0/hdf5-1.14.0-kf7aegm

####################################################

NETCDF_LIB      =       -L$(NETCDF_C_PATH)/lib -lnetcdf -L$(NETCDF_F_PATH)/lib -lnetcdff
HDF5_LIB        =       -L$(HDF5PATH)/lib -lhdf5_hl -lhdf5

DEBUGFLAGS	=	 
UNDERSCORE	=	-DUNDERSCORE 

FC_INCLUDES	=	-I. -I$(NETCDF_F_PATH)/include 
#FC_COMPILE_OPTIONS = 	-DUSE_GNU -cpp #-fdefault-real-8
FC_COMPILE_OPTIONS = 	-cpp #-fdefault-real-8

FC_OPTIMIZATIONS =	-g # -O3 

####################################################

#FC		=       gfortran
FC		=       ifort
FFLAGS		=       $(FC_US_FLAGS) $(FC_INCLUDES) $(FC_COMPILE_OPTIONS) $(FC_OPTIMIZATIONS)

LDFLAGS		=       #-L/usr/lib64 -ltcmalloc /usr/lib64/libpsm2.so.2

CPP		=       /usr/bin/cpp -C -P 
CPPFLAGS	=	-I. $(DEBUGFLAGS)

LOC_LIBS	=	$(NETCDF_LIB) $(HDF5_LIB) -lm -lc $(LDFLAGS)

RANLIB		=	ranlib
####################################################

